# Twitch application credentials from https://dev.twitch.tv/console/apps
# Leave both blank to run the sandbox. The secret must never be prefixed with VITE_.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Must match the OAuth redirect URL registered on the Twitch app.
# Default if unset: http://127.0.0.1:5173/oauth/callback
TWITCH_REDIRECT_URI=http://127.0.0.1:5173/oauth/callback
